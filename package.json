{
  "name": "vue3-olaii-common",
  "version": "1.0.0-alpha.0",
  "description": "Shared services, stores and components for the Olaii Vue 3 admin apps",
  "author": "Olaii",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.js",
    "!src/test"
  ],
  "module": "./dist/olaii-common.js",
  "exports": {
    ".": {
      "import": "./dist/olaii-common.js"
    },
    "./sentry": {
      "import": "./dist/sentry.js"
    },
    "./style.css": "./dist/olaii-common.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.5.0",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "vue-cookies": "^1.8.6"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.0",
    "vue3-gettext": ">=2.5.0-alpha.1 <3",
    "vue3-nice-elements": "^0.3.0",
    "@sentry/vue": "^10.19.0"
  },
  "peerDependenciesMeta": {
    "@sentry/vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vue": "^10.29.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pinia": "^3.0.3",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^4.5.1",
    "vue3-gettext": "2.5.0-alpha.1",
    "vue3-nice-elements": "^0.3.1"
  }
}
